# ==============================================================================
# CONFIGURATION ENVIRONNEMENT PRODUCTION - APPCV BACKEND
# ==============================================================================
# Ce fichier définit les paramètres pour l'environnement de production.
# Sur votre serveur mutualisé, personnalisez vos identifiants dans ce fichier
# ou dans un fichier .env.prod.local (qui reste privé et non commité).
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=e7b4c6e9a128df053d2bb8c09a80fa93c660f7e1b52de897f26189da9c72c1e4
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL publique principale de votre application en production
DEFAULT_URI=https://votredomaine.com
###< symfony/routing ###

###> nelmio/cors-bundle ###
# Expression régulière autorisant uniquement votre nom de domaine frontend en HTTPS
CORS_ALLOW_ORIGIN='^https://(www\.)?votredomaine\.com$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
# Connexion à la base de données MySQL de votre hébergeur mutualisé
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_BASE?serverVersion=8.0&charset=utf8mb4
DATABASE_URL="mysql://votre_utilisateur:votre_mot_de_passe@127.0.0.1:3306/votre_base_cv?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Mode synchrone direct sans worker : exécution immédiate idéale pour mutualisé
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
# Chemins des paires de clés RSA générées sur votre serveur
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=VOTRE_PASSPHRASE_JWT_SECURISEE
###< lexik/jwt-authentication-bundle ###

###> claude ###
# Clé API Claude Anthropic pour les analyses de CV en production
CLAUDE_API_KEY=sk-ant-api03-votre-cle-api-anthropic
CLAUDE_MODELE=claude-haiku-5-5
###< claude ###

###> cloudflare/turnstile ###
# Clé secrète Cloudflare Turnstile pour la vérification anti-bot en production (optionnel)
TURNSTILE_SECRET_KEY=
###< cloudflare/turnstile ###
